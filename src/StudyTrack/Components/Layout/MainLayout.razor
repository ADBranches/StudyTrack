@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 studytrack-topbar">
            <span class="app-tagline">Student Assignment and Study Planner</span>
        </div>

        <article class="content px-4">
            @Body
        </article>

        <footer class="studytrack-footer">
            StudyTrack • CSE 325 Group Project • Built for student planning and deadline tracking
        </footer>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
