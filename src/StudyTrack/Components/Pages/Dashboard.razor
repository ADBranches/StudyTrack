@page "/"
@page "/dashboard"

<PageTitle>StudyTrack Dashboard</PageTitle>

<h1>StudyTrack Dashboard</h1>

<p class="lead">
    Welcome to StudyTrack. This dashboard will summarize courses, assignments, deadlines, and study progress.
</p>

<section class="dashboard-grid">
    <div class="summary-card">
        <h2>Upcoming</h2>
        <p>Assignments due soon will appear here.</p>
    </div>

    <div class="summary-card">
        <h2>Overdue</h2>
        <p>Overdue assignments will be highlighted here.</p>
    </div>

    <div class="summary-card">
        <h2>Completed</h2>
        <p>Completed assignment progress will be shown here.</p>
    </div>
</section>
