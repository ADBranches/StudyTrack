@page "/"
@page "/dashboard"
@rendermode InteractiveServer
@using StudyTrack.Models
@using StudyTrack.Services
@using StudyTrack.Components.Shared
@inject DashboardService DashboardService

<PageTitle>StudyTrack Dashboard</PageTitle>

<h1>StudyTrack Dashboard</h1>

<p class="lead">
    Quickly review upcoming, overdue, completed, and high-priority assignments from one clear dashboard.
</p>

@if (isLoading)
{
    <p><em>Loading dashboard...</em></p>
}
else if (summary is not null)
{
    <section class="dashboard-grid">
        <div class="summary-card">
            <span class="summary-label">Total Assignments</span>
            <strong class="summary-number">@summary.TotalAssignments</strong>
        </div>

        <div class="summary-card">
            <span class="summary-label">Pending</span>
            <strong class="summary-number">@summary.PendingCount</strong>
        </div>

        <div class="summary-card summary-completed">
            <span class="summary-label">Completed</span>
            <strong class="summary-number">@summary.CompletedCount</strong>
        </div>

        <div class="summary-card summary-overdue">
            <span class="summary-label">Overdue</span>
            <strong class="summary-number">@summary.OverdueCount</strong>
        </div>

        <div class="summary-card summary-high">
            <span class="summary-label">High Priority</span>
            <strong class="summary-number">@summary.HighPriorityCount</strong>
        </div>
    </section>

    <section class="dashboard-section">
        <h2>Upcoming Assignments</h2>

        @if (summary.UpcomingAssignments.Count == 0)
        {
            <div class="empty-state">No upcoming assignments in the next 7 days.</div>
        }
        else
        {
            <div class="dashboard-list">
                @foreach (var assignment in summary.UpcomingAssignments)
                {
                    <article class="dashboard-list-item">
                        <div class="dashboard-item-main">
                            <a href="@($"/assignments/{assignment.Id}")" class="dashboard-item-title">@assignment.Title</a>
                            <div class="muted-text">@(assignment.Course?.Name ?? "No course") • Due @assignment.DueDate.ToString("yyyy-MM-dd")</div>
                        </div>

                        <div class="dashboard-badge-row">
                            <PriorityBadge Priority="assignment.Priority" />
                            <StatusBadge Status="assignment.Status" />
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="dashboard-section dashboard-urgent">
        <h2>Overdue Assignments</h2>

        @if (summary.OverdueAssignments.Count == 0)
        {
            <div class="empty-state">No overdue assignments.</div>
        }
        else
        {
            <div class="dashboard-list">
                @foreach (var assignment in summary.OverdueAssignments)
                {
                    <article class="dashboard-list-item">
                        <div class="dashboard-item-main">
                            <a href="@($"/assignments/{assignment.Id}")" class="dashboard-item-title">@assignment.Title</a>
                            <div class="muted-text">@(assignment.Course?.Name ?? "No course") • Due @assignment.DueDate.ToString("yyyy-MM-dd")</div>
                        </div>

                        <div class="dashboard-badge-row">
                            <PriorityBadge Priority="assignment.Priority" />
                            <StatusBadge Status="assignment.Status" />
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="dashboard-section">
        <h2>High-Priority Assignments</h2>

        @if (summary.HighPriorityAssignments.Count == 0)
        {
            <div class="empty-state">No high-priority pending assignments.</div>
        }
        else
        {
            <div class="dashboard-list">
                @foreach (var assignment in summary.HighPriorityAssignments)
                {
                    <article class="dashboard-list-item">
                        <div class="dashboard-item-main">
                            <a href="@($"/assignments/{assignment.Id}")" class="dashboard-item-title">@assignment.Title</a>
                            <div class="muted-text">@(assignment.Course?.Name ?? "No course") • Due @assignment.DueDate.ToString("yyyy-MM-dd")</div>
                        </div>

                        <div class="dashboard-badge-row">
                            <PriorityBadge Priority="assignment.Priority" />
                            <StatusBadge Status="assignment.Status" />
                        </div>
                    </article>
                }
            </div>
        }
    </section>
}

@code {
    private DashboardSummary? summary;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        summary = await DashboardService.GetDashboardSummaryAsync();
        isLoading = false;
    }
}
