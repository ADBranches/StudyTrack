@page "/Error"
@using System.Diagnostics

<PageTitle>Application Error</PageTitle>

<h1 class="text-danger">Something went wrong</h1>

<div class="alert alert-danger feedback-panel" role="alert">
    StudyTrack encountered an unexpected issue. Please return to the dashboard and try again.
</div>

<p>
    If the problem continues, record the page you were using and the action you attempted.
</p>

@if (ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@RequestId</code>
    </p>
}

<a class="btn btn-primary" href="/">Back to Dashboard</a>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrWhiteSpace(RequestId);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
